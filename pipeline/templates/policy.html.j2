{% extends "base.html.j2" %}
{% set og_type = "article" %}
{% block head_extra %}<script type="application/ld+json">{{ jsonld | safe }}</script>
<script src="/policy.js" defer></script>{% endblock %}

{% macro contact_item(c) %}<li>{% if c.name %}<span class="c-name">{{ c.name }}</span>{% endif %}{% if c.tel %}<a class="c-tel" href="tel:{{ c.tel }}"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/></svg>{{ c.phone }}</a>{% elif c.phone %}<span class="c-num">{{ c.phone }}</span>{% endif %}</li>{% endmacro %}

{% block main %}
<main class="wrap doc">
  <nav class="crumbs"><a href="/">내 혜택 찾기</a> › <a href="{{ field_url }}">{{ s["서비스분야"] }}</a></nav>
  <div class="banner" style="--h: {{ art.hue }}">
    <span class="thumb thumb-lg" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="{{ art.d }}"/></svg></span>
    <div>
      <div class="badges">
        <span class="badge badge-brand">{{ s["서비스분야"] }}</span>
        {% if s["지원유형"] %}<span class="badge">{{ s["지원유형"]|items }}</span>{% endif %}
      </div>
      <h1>{{ s["서비스명"] }}</h1>
    </div>
  </div>
  {% if s["서비스목적요약"] %}<p class="lead" style="margin-top:18px">{{ s["서비스목적요약"] }}</p>{% endif %}

  <dl class="facts card">
    <div><dt>소관기관</dt><dd>{{ s["소관기관명"] }}</dd></div>
    {% if s["접수기관"] %}<div><dt>접수기관</dt><dd>{{ s["접수기관"] }}</dd></div>{% endif %}
    {% if contacts %}
    <div class="facts-wide"><dt>문의</dt><dd>
      <ul class="contacts">{% for c in contacts[:3] %}{{ contact_item(c) }}{% endfor %}</ul>
      {% if contacts|length > 3 %}
      <details class="contacts-more"><summary>문의처 {{ contacts|length - 3 }}곳 더 보기</summary>
        <ul class="contacts">{% for c in contacts[3:] %}{{ contact_item(c) }}{% endfor %}</ul>
      </details>
      {% endif %}
    </dd></div>
    {% endif %}
    <div><dt>출처</dt><dd>행정안전부 보조금24{% if source_date %} · 수정 {{ source_date }}{% endif %}</dd></div>
  </dl>

  {% set ext_icon %}<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5"/></svg>{% endset %}
  <div class="cta-row">
    {% if detail.apply_url %}
    <a class="btn btn-primary" href="{{ detail.apply_url }}" rel="noopener nofollow" target="_blank">온라인으로 신청하기 {{ ext_icon }}</a>
    <a class="btn" href="{{ s['상세조회URL'] }}" rel="noopener nofollow" target="_blank">공식 상세 페이지 보기 {{ ext_icon }}</a>
    {% else %}
    <a class="btn btn-primary" href="{{ s['상세조회URL'] }}" rel="noopener nofollow" target="_blank">공식 페이지에서 신청·확인하기 {{ ext_icon }}</a>
    {% endif %}
    <button type="button" class="btn btn-save" data-save data-id="{{ s['서비스ID'] }}" aria-pressed="false" hidden><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4h12v17l-6-4-6 4z"/></svg><span>저장</span></button>
    <a class="btn" href="/">내 조건에 맞는 다른 혜택 찾기</a>
  </div>
  {% if deadline.state == "closed" %}
  <div class="notice-card warn" role="status"><b>신청 기간이 끝난 것으로 보여요.</b> 종료일 {{ deadline.end_fmt }}. 다음 모집 일정은 공식 페이지에서 확인하세요.</div>
  {% elif deadline.state == "upcoming" %}
  <div class="notice-card info" role="status"><b>접수 예정</b> · {{ deadline.start_fmt }}부터{% if deadline.end_fmt %} {{ deadline.end_fmt }}까지{% endif %}</div>
  {% elif deadline.state == "open" %}
  <div class="notice-card {{ 'warn' if deadline.dday <= 7 else 'info' }}" role="status"><b>신청 마감 {{ deadline.end_fmt }}</b> · {% if deadline.dday == 0 %}오늘 마감{% else %}D-{{ deadline.dday }}{% endif %}</div>
  {% endif %}
  {% if deadline.state in ("open", "upcoming") and deadline.end %}
  <p class="cal-row"><button type="button" class="btn" data-ics data-id="{{ s['서비스ID'] }}" data-name="{{ s['서비스명'] }}" data-end="{{ deadline.end }}" hidden><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16v14H4zM4 10h16M8 3v4M16 3v4"/></svg>마감일을 달력에 추가</button><span class="muted">마감 3일 전에 알려 줘요</span></p>
  {% endif %}
  {% if detail.apply_url %}<p class="muted" style="margin-top:8px">신청 사이트 주소는 공공데이터에 등록된 값이며 변경되었을 수 있습니다.</p>{% endif %}

  {% if no_conditions %}
  <section class="who card">
    <h2>이런 분이 해당될 수 있어요</h2>
    <p>공공데이터에 지원조건 코드가 없는 서비스입니다. 아래 원문과 공식 페이지에서 대상을 확인하세요.</p>
  </section>
  {% else %}
  <section class="who card">
    <h2>이런 분이 해당될 수 있어요</h2>
    {% if who %}
    <dl>{% for k, v in who %}<dt>{{ k }}</dt><dd>{{ v }}{% if k == "나이" %} <span class="muted">공공데이터 기준이며 실제와 다를 수 있어요. 원문을 확인하세요.</span>{% endif %}</dd>{% endfor %}</dl>
    {% else %}
    <p>공공데이터상 나이·소득·상황에 대한 별도 제한 코드가 없습니다. 세부 요건은 아래 원문을 확인하세요.</p>
    {% endif %}
    <p class="muted">공공데이터의 지원조건 코드를 정리한 것으로, 실제 자격은 아래 원문과 공식 페이지 기준입니다.</p>
  </section>
  {% endif %}

  {% for label, key in sections %}
  {% if s[key] %}
  <section class="card">
    <h2>{{ label }}</h2>
    {% for para in paragraphs(s[key]) %}<p>{{ para }}</p>{% endfor %}
  </section>
  {% endif %}
  {% endfor %}

  {% if detail.docs or detail.docs_official or detail.docs_self %}
  <section class="card" id="docs" data-checklist data-policy="{{ s['서비스ID'] }}" data-title="{{ s['서비스명'] }} 준비 서류">
    <div class="card-head"><h2>필요한 서류</h2><span class="progress muted" data-progress hidden></span></div>
    {% if detail.docs %}<ul class="check-list">{% for line in detail.docs %}<li><label><input type="checkbox"><span>{{ line }}</span></label></li>{% endfor %}</ul>{% endif %}
    {% if detail.docs_official %}
    <h3 class="sub">담당 공무원이 확인하는 서류 <span class="muted">(직접 준비하지 않아도 돼요)</span></h3>
    <ul class="plain-list">{% for line in detail.docs_official %}<li>{{ line }}</li>{% endfor %}</ul>
    {% endif %}
    {% if detail.docs_self %}
    <h3 class="sub">본인 확인이 필요한 서류</h3>
    <ul class="check-list">{% for line in detail.docs_self %}<li><label><input type="checkbox"><span>{{ line }}</span></label></li>{% endfor %}</ul>
    {% endif %}
    {% if detail.docs or detail.docs_self %}
    <p class="muted doc-note">체크 표시는 이 기기의 브라우저에만 저장돼요. 서류는 상황에 따라 달라질 수 있으니 신청 전에 공식 페이지에서 한 번 더 확인하세요.</p>
    <div class="doc-actions"><button type="button" class="btn" data-copy-docs hidden>준비물 목록 복사</button></div>
    {% endif %}
  </section>
  {% endif %}

  {% if detail.laws or detail.local_rules %}
  <section class="card">
    <h2>근거 법령</h2>
    <ul class="plain-list">
      {% for name in detail.laws %}<li>{{ name }}</li>{% endfor %}
      {% for name in detail.local_rules %}<li>{{ name }} <span class="muted">(자치법규)</span></li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  <section class="card report">
    <h2>정보가 다른가요?</h2>
    <p>공식 페이지와 다른 내용을 발견하셨다면 알려 주세요. 확인 후 고치겠습니다.</p>
    <p class="muted">신고는 GitHub에 공개됩니다. 개인정보는 적지 마세요. GitHub 계정이 필요합니다.</p>
    <p><a class="btn" href="{{ report_url }}" target="_blank" rel="noopener">정보 오류 알리기</a></p>
  </section>

  {% if related %}
  <section class="card">
    <h2>함께 보면 좋은 지원</h2>
    <ul class="link-list">{% for r in related %}<li><a href="/p/{{ r['서비스ID'] }}">{{ r["서비스명"] }}<span class="muted">{{ r["소관기관명"] }}</span></a></li>{% endfor %}</ul>
  </section>
  {% endif %}
</main>
{% endblock %}

{% block footer_note %}<p>이 페이지는 공공데이터를 그대로 안내하는 것이며 자격을 확정하지 않습니다. 지원 여부와 신청은 반드시 위 공식 페이지에서 확인하세요.</p>{% endblock %}
